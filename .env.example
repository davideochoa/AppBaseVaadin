# Copy this file to .env and adjust as needed. Never commit .env itself.
# All values below are the defaults docker-compose.yml already falls back
# to when a variable is unset, so an empty .env (or no .env at all) is
# enough to run the stack locally.

# --- ms-users database ---
DB_USERS_NAME=ms_users
DB_USERS_USER=ms_users_app
DB_USERS_PASSWORD=ms_users_pass

# --- ms-security database ---
DB_SECURITY_NAME=ms_security
DB_SECURITY_USER=ms_security_app
DB_SECURITY_PASSWORD=ms_security_pass

# --- ms-audit database ---
DB_AUDIT_NAME=ms_audit
DB_AUDIT_USER=ms_audit_app
DB_AUDIT_PASSWORD=ms_audit_pass

# --- ms-security: JWT signing (RS256) ---
# Leave both blank for local/demo use: ms-security generates an ephemeral
# in-memory keypair at startup (logs a WARN). Set both to real PEM values
# for any environment shared beyond this machine.
APP_JWT_PRIVATE_KEY_PEM=
APP_JWT_PUBLIC_KEY_PEM=
ACCESS_TOKEN_TTL_MINUTES=10
REFRESH_TOKEN_TTL_DAYS=7

# --- Google OAuth2/OIDC login (optional) ---
# Leave blank to disable the "Sign in with Google" button.
GOOGLE_CLIENT_ID=

# --- Kafka ---
AUDIT_TOPIC=audit

# --- CORS ---
# This must be the Origin the browser actually sends (where app-vaadin is
# reachable from), NOT the app-vaadin container's internal service name.
APP_VAADIN_ORIGIN=http://localhost:8080
